{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/oklookat/teletrack/raw/refs/heads/main/config.schema.json",
    "title": "Teletrack Configuration",
    "type": "object",
    "required": [
        "telegram",
        "players"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "telegram": {
            "type": "object",
            "required": [
                "token",
                "userID",
                "chatID",
                "serviceChatID",
                "messageID"
            ],
            "properties": {
                "token": {
                    "type": "string"
                },
                "userID": {
                    "type": "integer"
                },
                "chatID": {
                    "type": "string"
                },
                "serviceChatID": {
                    "type": "string"
                },
                "messageID": {
                    "type": "integer"
                }
            },
            "additionalProperties": false
        },
        "lastFm": {
            "type": "object",
            "required": [
                "apiKey",
                "username"
            ],
            "properties": {
                "apiKey": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "spotify": {
            "type": "object",
            "required": [
                "redirectURI",
                "clientID",
                "clientSecret"
            ],
            "properties": {
                "authorize": {
                    "type": "boolean",
                    "default": false
                },
                "redirectURI": {
                    "type": "string"
                },
                "clientID": {
                    "type": "string"
                },
                "clientSecret": {
                    "type": "string"
                },
                "token": {
                    "type": "object",
                    "required": [
                        "access_token",
                        "token_type",
                        "refresh_token",
                        "expiry",
                        "expires_in"
                    ],
                    "properties": {
                        "access_token": {
                            "type": "string"
                        },
                        "token_type": {
                            "type": "string"
                        },
                        "refresh_token": {
                            "type": "string"
                        },
                        "expiry": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "expires_in": {
                            "type": "integer"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "if": {
                "properties": {
                    "authorize": {
                        "const": false
                    }
                }
            },
            "then": {
                "required": [
                    "token"
                ]
            },
            "additionalProperties": false
        },
        "listenBrainz": {
            "type": "object",
            "required": [
                "username",
                "token"
            ],
            "properties": {
                "username": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "players": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "spotify",
                    "lastFm",
                    "listenBrainz"
                ]
            }
        },
        "bios": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "lastFm",
                    "listenBrainz"
                ]
            }
        },
        "cache": {
            "type": "object",
            "properties": {
                "maxEntries": {
                    "type": "integer",
                    "minimum": 0
                },
                "successTTL": {
                    "type": "string"
                },
                "failureTTL": {
                    "type": "string"
                },
                "cleanupInterval": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "comment": "If 'spotify' is listed in players, the top-level spotify object is required.",
            "if": {
                "properties": {
                    "players": {
                        "contains": {
                            "const": "spotify"
                        }
                    }
                },
                "required": [
                    "players"
                ]
            },
            "then": {
                "required": [
                    "spotify"
                ]
            }
        },
        {
            "comment": "If 'lastFm' is listed in players or bios, the top-level lastFm object is required.",
            "if": {
                "anyOf": [
                    {
                        "properties": {
                            "players": {
                                "contains": {
                                    "const": "lastFm"
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "bios": {
                                "contains": {
                                    "const": "lastFm"
                                }
                            }
                        }
                    }
                ]
            },
            "then": {
                "required": [
                    "lastFm"
                ]
            }
        },
        {
            "comment": "If 'listenBrainz' is listed in players or bios, the top-level listenBrainz object is required.",
            "if": {
                "anyOf": [
                    {
                        "properties": {
                            "players": {
                                "contains": {
                                    "const": "listenBrainz"
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "bios": {
                                "contains": {
                                    "const": "listenBrainz"
                                }
                            }
                        }
                    }
                ]
            },
            "then": {
                "required": [
                    "listenBrainz"
                ]
            }
        }
    ],
    "additionalProperties": false
}