{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/oklookat/teletrack/raw/refs/heads/main/config.schema.json",
    "title": "Teletrack Configuration",
    "type": "object",
    "required": [
        "players",
        "renderers"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "telegram": {
            "type": "object",
            "required": [
                "token",
                "userID",
                "chatID",
                "serviceChatID",
                "messageID"
            ],
            "properties": {
                "token": {
                    "type": "string"
                },
                "userID": {
                    "type": "integer"
                },
                "chatID": {
                    "type": "string"
                },
                "serviceChatID": {
                    "type": "string"
                },
                "messageID": {
                    "type": "integer"
                }
            },
            "additionalProperties": false
        },
        "lastFm": {
            "type": "object",
            "required": [
                "apiKey",
                "username"
            ],
            "properties": {
                "apiKey": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "spotify": {
            "type": "object",
            "required": [
                "redirectURI",
                "clientID",
                "clientSecret"
            ],
            "properties": {
                "authorize": {
                    "type": "boolean",
                    "default": false
                },
                "redirectURI": {
                    "type": "string"
                },
                "clientID": {
                    "type": "string"
                },
                "clientSecret": {
                    "type": "string"
                },
                "token": {
                    "type": "object",
                    "required": [
                        "access_token",
                        "token_type",
                        "refresh_token",
                        "expiry",
                        "expires_in"
                    ],
                    "properties": {
                        "access_token": {
                            "type": "string"
                        },
                        "token_type": {
                            "type": "string"
                        },
                        "refresh_token": {
                            "type": "string"
                        },
                        "expiry": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "expires_in": {
                            "type": "integer"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "if": {
                "properties": {
                    "authorize": {
                        "const": false
                    }
                }
            },
            "then": {
                "required": [
                    "token"
                ]
            },
            "additionalProperties": false
        },
        "listenBrainz": {
            "type": "object",
            "required": [
                "username",
                "token"
            ],
            "properties": {
                "username": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "players": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "spotify",
                    "lastFm",
                    "listenBrainz"
                ]
            }
        },
        "bios": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "lastFm",
                    "listenBrainz"
                ]
            }
        },
        "renderers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "telegram",
                    "html",
                    "api"
                ]
            },
            "default": [
                "telegram"
            ]
        },
        "html": {
            "type": "object",
            "properties": {
                "addr": {
                    "type": "string",
                    "description": "Listen address. Use :443 or 0.0.0.0:8787 for public access.",
                    "default": "127.0.0.1:8787"
                },
                "tlsCertFile": {
                    "type": "string",
                    "description": "Path to TLS certificate PEM (enable HTTPS when set with tlsKeyFile)"
                },
                "tlsKeyFile": {
                    "type": "string",
                    "description": "Path to TLS private key PEM"
                },
                "apiPathPrefix": {
                    "type": "string",
                    "description": "URL prefix for the embedded Teletrack API (playing + events). Default /api/v1/teletrack.",
                    "default": "/api/v1/teletrack"
                }
            },
            "additionalProperties": false
        },
        "api": {
            "type": "object",
            "description": "Standalone HTTP API for third-party sites and widgets (no built-in UI).",
            "properties": {
                "addr": {
                    "type": "string",
                    "description": "Listen address. Default 127.0.0.1:8790.",
                    "default": "127.0.0.1:8790"
                },
                "pathPrefix": {
                    "type": "string",
                    "description": "URL prefix for API routes. Default /api/v1/teletrack.",
                    "default": "/api/v1/teletrack"
                },
                "tlsCertFile": {
                    "type": "string",
                    "description": "Path to TLS certificate PEM"
                },
                "tlsKeyFile": {
                    "type": "string",
                    "description": "Path to TLS private key PEM"
                },
                "cors": {
                    "type": "object",
                    "properties": {
                        "allowedOrigins": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Allowed Origin values. Use [\"*\"] to allow any origin."
                        },
                        "allowedMethods": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "allowedHeaders": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "allowCredentials": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "cache": {
            "type": "object",
            "properties": {
                "maxEntries": {
                    "type": "integer",
                    "minimum": 0
                },
                "successTTL": {
                    "type": "string",
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
                },
                "failureTTL": {
                    "type": "string",
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
                },
                "cleanupInterval": {
                    "type": "string",
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+$"
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "comment": "If 'spotify' is listed in players, the top-level spotify object is required.",
            "if": {
                "properties": {
                    "players": {
                        "contains": {
                            "const": "spotify"
                        }
                    }
                },
                "required": [
                    "players"
                ]
            },
            "then": {
                "required": [
                    "spotify"
                ]
            }
        },
        {
            "comment": "If 'lastFm' is listed in players or bios, the top-level lastFm object is required.",
            "if": {
                "anyOf": [
                    {
                        "properties": {
                            "players": {
                                "contains": {
                                    "const": "lastFm"
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "bios": {
                                "contains": {
                                    "const": "lastFm"
                                }
                            }
                        }
                    }
                ]
            },
            "then": {
                "required": [
                    "lastFm"
                ]
            }
        },
        {
            "comment": "If 'listenBrainz' is listed in players or bios, the top-level listenBrainz object is required.",
            "if": {
                "anyOf": [
                    {
                        "properties": {
                            "players": {
                                "contains": {
                                    "const": "listenBrainz"
                                }
                            }
                        }
                    },
                    {
                        "properties": {
                            "bios": {
                                "contains": {
                                    "const": "listenBrainz"
                                }
                            }
                        }
                    }
                ]
            },
            "then": {
                "required": [
                    "listenBrainz"
                ]
            }
        },
        {
            "comment": "If 'telegram' is listed in renderers, the top-level telegram object is required.",
            "if": {
                "properties": {
                    "renderers": {
                        "contains": {
                            "const": "telegram"
                        }
                    }
                }
            },
            "then": {
                "required": [
                    "telegram"
                ]
            }
        },
        {
            "comment": "If 'html' is listed in renderers, the top-level html object is optional but recommended.",
            "if": {
                "properties": {
                    "renderers": {
                        "contains": {
                            "const": "html"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "html": {
                        "type": "object",
                        "properties": {
                            "addr": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        {
            "comment": "If 'api' is listed in renderers, the top-level api object is optional but recommended.",
            "if": {
                "properties": {
                    "renderers": {
                        "contains": {
                            "const": "api"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "api": {
                        "type": "object",
                        "properties": {
                            "addr": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    ],
    "additionalProperties": false
}